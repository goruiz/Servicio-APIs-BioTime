# Configuración de la aplicación
PROJECT_NAME=Servicio APIs BioTime
VERSION=1.0.0
DEBUG=True

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS (separar múltiples orígenes con comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# BioTime API
BIOTIME_BASE_URL=http://localhost:8081/
BIOTIME_USERNAME=TEST
BIOTIME_PASSWORD=your_password_here
BIOTIME_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
